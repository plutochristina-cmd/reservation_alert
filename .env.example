# 텔레그램 봇 설정 (필수)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 알림 동작 옵션 (선택 사항)
# NOTIFY_ALWAYS=true : 예약 가능 슬롯이 있으면 변동 여부와 상관없이 매 실행마다 발송
# NOTIFY_ALWAYS=false : 최단 예약 가능 슬롯 목록(Top 3)이 변경되었을 때만 발송 (기본값: false, 알림 도배 방지)
NOTIFY_ALWAYS=false

# 최대 조회 일수 (기본값: 365일 = 미래 1년)
TARGET_MAX_DAYS=365

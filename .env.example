# ==============================================================================
# 네이버 / 캐치테이블 / 놀티켓 예약 알리미 환경 설정 예시 (.env.example)
# 다른 PC에서 프로젝트 실행 시 이 파일을 복사하여 '.env' 파일로 저장 후 사용하세요.
# ==============================================================================

# [1] Supabase 설정 (필수: PWA 대시보드 및 다중 사용자 예약 데이터베이스)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# 스케줄러 관리자 권한이 필요한 경우 (선택)
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# [2] Web Push VAPID 키 (필수: 스마트폰/브라우저 푸시 알림 발송용)
# generate_vapid_keys.py 를 실행하여 생성할 수 있습니다.
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_CLAIMS_SUB=mailto:admin@example.com

# [3] Vercel 배포 연동 (선택: deploy.py 자동 배포 스크립트 사용 시)
VERCEL_TOKEN=your_vercel_token_here

# [4] 텔레그램 봇 설정 (선택: monitor.py 단독 로컬 모니터링 사용 시)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# [5] 알림 및 모니터링 옵션 (선택)
# NOTIFY_ALWAYS=true : 예약 가능 슬롯이 있으면 변동 여부와 상관없이 매 실행마다 발송
# NOTIFY_ALWAYS=false : 최단 예약 가능 슬롯 목록(Top 3)이 변경되었을 때만 발송 (기본값: false, 알림 도배 방지)
NOTIFY_ALWAYS=false
TARGET_MAX_DAYS=365
